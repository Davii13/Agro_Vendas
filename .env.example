# Copy this file to ".env" (which git ignores) and fill in real values.
# Nothing here has a safe default: the stack refuses to start without them.
# Generate every secret with:  openssl rand -base64 48   (or:  openssl rand -hex 24)

# PostgreSQL superuser password. Used only for maintenance; the application never uses it.
DB_ADMIN_PASSWORD=<long random password>

# The application's own database role (not a superuser). It is created on first start.
DB_USERNAME=agrovendas_app
DB_PASSWORD=<another long random password>

# JWT signing key: random, at least 64 bytes:  openssl rand -base64 64
JWT_SECRET=<output of the command above, on one line>

# First administrator. Used only while no active ADMIN exists.
# If the e-mail already belongs to an account it is promoted; otherwise the account is
# created with ADMIN_PASSWORD (8+ characters, letters and numbers).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Browser origin(s) allowed to call the API, comma separated. In production: your https:// address.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Address of the API as the browser sees it (baked into the front-end at build time).
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Behind a reverse proxy, set to "native" so login rate limiting uses the real client address.
FORWARD_HEADERS_STRATEGY=none
